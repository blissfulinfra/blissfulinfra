# Build the blissful-infra dashboard container.
# Context must be the repo root so the monorepo workspace is available.
#
# docker build -f Dockerfile.dashboard -t blissful-infra .

# ── Stage 1: install all workspace dependencies ───────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /repo

# Build tools for native modules (node-pty has a small native component).
RUN apk add --no-cache python3 make g++

# Copy manifests first so layer cache survives source-only changes
COPY package.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/cli/package.json ./packages/cli/
COPY packages/dashboard/package.json ./packages/dashboard/

# Skip lifecycle scripts: the root postinstall builds the shared package,
# but its source isn't COPYed yet. node-pty's native module is rebuilt
# explicitly below once the build tools are confirmed present.
RUN npm install --ignore-scripts
RUN npm rebuild node-pty

# ── Stage 2: build shared → cli → dashboard ───────────────────────────────────
FROM deps AS build
WORKDIR /repo

COPY packages/shared/ ./packages/shared/
COPY packages/cli/ ./packages/cli/
COPY packages/dashboard/ ./packages/dashboard/

RUN npm run build -w packages/shared
RUN npm run build -w packages/cli
RUN npm run build -w packages/dashboard

# ── Stage 3: lean runtime image ───────────────────────────────────────────────
FROM node:20-alpine
# bash + common operator tools so the in-dashboard terminal feels familiar.
# libstdc++ keeps node-pty's prebuilt .node loadable at runtime on Alpine.
RUN apk add --no-cache docker-cli docker-cli-compose bash curl vim git ncurses libstdc++

# Claude Code CLI — lets the in-container Agent endpoint reach Claude.ai via
# the user's subscription instead of demanding an ANTHROPIC_API_KEY env var.
# Auth credentials live in /root/.claude, which the compose file bind-mounts
# from ~/.blissful-infra/dashboard-claude on the host so the login survives
# container recreates. First-time setup: `blissful-infra dashboard login`.
RUN npm install -g @anthropic-ai/claude-code@latest

WORKDIR /app

# MCP config — when `claude -p` runs from /app (set as cwd in
# claudeChatViaCli), it auto-loads .mcp.json and our MCP server becomes
# available as tools. The agent then RETRIEVES (list_projects, get_health,
# query_logs, etc.) rather than us pre-stuffing the prompt with logs.
RUN printf '{\n  "mcpServers": {\n    "blissful-infra": {\n      "command": "node",\n      "args": ["/app/dist/index.js", "mcp"]\n    }\n  }\n}\n' > /app/.mcp.json

# CLI dist, templates, and package manifest
COPY --from=build /repo/packages/cli/dist ./dist
COPY --from=build /repo/packages/cli/templates ./templates
COPY --from=build /repo/packages/cli/package.json ./package.json

# Copy node_modules from the root workspace install
COPY --from=build /repo/node_modules ./node_modules

# Workspace symlinks don't survive multi-stage COPY — explicitly place the
# compiled shared package where Node expects to find it at runtime.
COPY --from=build /repo/packages/shared/package.json ./node_modules/@blissful-infra/shared/package.json
COPY --from=build /repo/packages/shared/dist ./node_modules/@blissful-infra/shared/dist

# Dashboard static assets
COPY --from=build /repo/packages/dashboard/dist ./dashboard-dist

ENV DASHBOARD_DIST_DIR=/app/dashboard-dist
ENV DASHBOARD_PORT=3002
ENV PROJECTS_DIR=/projects
ENV DOCKER_MODE=true

EXPOSE 3002

CMD ["node", "dist/server/entrypoint.js"]
